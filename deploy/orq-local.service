# CASO 1 - orquestador contra el archivo SQLite local.
# Instalar en /etc/systemd/system/orq-local.service
#
# User=root porque el puerto 80 es privilegiado.
# No lleva Requires=mariadb.service: no hay motor de base de datos, solo un
# archivo .db en el mismo directorio de la app.
#
# OJO: los cuatro casos usan el puerto 80, solo puede haber uno activo:
#   sudo systemctl stop orq-remoto && sudo systemctl start orq-local

[Unit]
Description=Orquestador IoT - caso 1 (archivo local SQLite)
After=network.target

[Service]
User=root
WorkingDirectory=/home/ubuntu/iot/local
ExecStart=/home/ubuntu/iot/local/venv/bin/python app.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
